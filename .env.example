# Google Gemini API Key (https://aistudio.google.com/ থেকে সম্পূর্ণ ফ্রিতে নেওয়া যায়)
GEMINI_API_KEY=your_gemini_api_key_here

# আপনার নাম (এজেন্ট জানবে কার জন্য সে কাজ করছে)
OWNER_NAME=Owner

# এজেন্টের নাম
AGENT_NAME="Personal AI Assistant"

# AI মডেল (gemini-1.5-flash বা gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# শুরুর সময় বট কি অন থাকবে? (true অথবা false)
AUTO_REPLY_ACTIVE=true

# গ্রুপ মেসেজে কি অটো-রিপ্লাই দেবে? (সাধারণত false রাখা ভালো)
REPLY_TO_GROUPS=false
